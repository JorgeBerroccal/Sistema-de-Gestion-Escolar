# Plantilla del archivo /opt/sge/.env del servidor de staging (permisos 0600, propietario sge).
# Copiar a /opt/sge/.env y reemplazar TODOS los marcadores <...>. Nunca versionar el resultado.
# Generar secretos:   openssl rand -base64 24
# Generar APP_KEY:    docker run --rm ghcr.io/<propietario>/sge-app:<etiqueta> php artisan key:generate --show

# --- Aplicación --------------------------------------------------------------
APP_NAME=SGE
APP_ENV=staging
APP_DEBUG=false
APP_KEY=<APP_KEY generada con key:generate --show>
APP_URL=https://<fqdn>
APP_LOCALE=es
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=info

BCRYPT_ROUNDS=12

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
CACHE_STORE=redis
QUEUE_CONNECTION=sync

# --- Base de datos (la aplicación recibe solo DB_USERNAME/DB_PASSWORD) ------------
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=sge
DB_USERNAME=sge
DB_PASSWORD=<aleatoria, >= 24 caracteres>
# Solo la recibe el contenedor db (FR-032); respaldo y restauración la usan dentro de ese contenedor.
DB_ROOT_PASSWORD=<aleatoria, >= 24 caracteres, distinta de DB_PASSWORD>

# --- Redis ---------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Administrador inicial (AdministradorInicialSeeder) ------------------------
SGE_ADMIN_USERNAME=<usuario del administrador>
SGE_ADMIN_EMAIL=<correo del administrador>
# Fuerte (>= 16 caracteres) y distinta de cualquier valor de ejemplo
SGE_ADMIN_PASSWORD=<contraseña fuerte>

# --- OPcache: sin validar marcas de tiempo; php artisan optimize corre al arrancar ----
OPCACHE_VALIDATE_TIMESTAMPS=0

# --- Despliegue ----------------------------------------------------------------
REGISTRO=ghcr.io/<propietario en minúsculas>
FQDN=<nombre>.<región>.cloudapp.azure.com
# La escribe deploy/deploy.sh solo cuando /up informa la versión solicitada
SGE_VERSION=<etiqueta, p. ej. v0.2.0>

# --- Perfil de tamaño: diario (B2ats_v2, 1 GB) o carga (D2s_v4, 8 GB) -------------
# deploy.sh lee PERFIL_TAMANO y exporta el resto de valores de la tabla de
# specs/002-despliegue-ci-staging/contracts/variables-entorno.md; no hace falta repetirlos aquí.
PERFIL_TAMANO=diario
