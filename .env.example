APP_NAME=SGE
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=sge
DB_USERNAME=sge
DB_PASSWORD=secret
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# UID/GID del usuario del host para construir la imagen `app` (id -u / id -g).
# Se leen del entorno o de .env al ejecutar docker compose (UID no se exporta en bash).
HOST_UID=1000
HOST_GID=1000

# OPcache: 1 en desarrollo (recarga archivos); 0 en producción (junto con `php artisan optimize`)
OPCACHE_VALIDATE_TIMESTAMPS=1

# Administrador inicial (AdministradorInicialSeeder)
SGE_ADMIN_USERNAME=admin
SGE_ADMIN_EMAIL=admin@example.com
# OBLIGATORIO: definir una contraseña (mínimo 8 caracteres) antes de ejecutar los seeders.
SGE_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Despliegue en staging (solo se usan en el .env del servidor; ver docs/despliegue/
# y deploy/env.staging.example). En desarrollo local se dejan comentadas.
# ---------------------------------------------------------------------------
# Versión desplegada: la escribe deploy/deploy.sh; /up la informa en su respuesta JSON.
# SGE_VERSION=dev
# Registro de imágenes y nombre público del servidor
# REGISTRO=ghcr.io/<propietario>
# FQDN=<nombre>.<región>.cloudapp.azure.com
# Perfil de tamaño: diario (B2ats_v2, 1 GB) o carga (D2s_v4, 8 GB)
# PERFIL_TAMANO=diario
# Cookies solo por HTTPS
# SESSION_SECURE_COOKIE=true
# Contraseña root de MySQL: solo la recibe el contenedor db, nunca la aplicación
# DB_ROOT_PASSWORD=
# Dimensionado (los aplica deploy.sh según PERFIL_TAMANO; defaults de desarrollo entre paréntesis)
# FPM_MAX_CHILDREN=20
# FPM_START_SERVERS=6
# FPM_MIN_SPARE=4
# FPM_MAX_SPARE=10
# PHP_MEMORY_LIMIT=128M
# MYSQL_BUFFER_POOL=256M
# MYSQL_MAX_CONNECTIONS=151
# REDIS_MAXMEMORY=256mb
