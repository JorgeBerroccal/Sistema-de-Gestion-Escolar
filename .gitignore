# Claude Code: configuración local y credenciales (las skills compartidas sí se versionan)
.claude/settings.local.json
.claude/.credentials.json
.claude/**/*credentials*
.claude/**/*.local.*

# Variables de entorno (se versiona solo la plantilla .env.example)
.env
.env.*
!.env.example

# Dependencias
/vendor/
/node_modules/

# Laravel: storage/ y bootstrap/cache/ ya traen sus propios .gitignore anidados
# (patrón `*` + `!.gitignore` en cada subcarpeta) que versionan la estructura de
# directorios e ignoran su contenido de runtime; no se necesita nada aquí para ellos.
/public/build/
/public/hot
/public/storage
/public/fonts-manifest.dev.json

# Pruebas y herramientas
/.phpunit.cache/
.phpunit.result.cache
/coverage/
auth.json
_ide_helper.php
.phpactor.json
Homestead.json
Homestead.yaml

# Docker: datos persistentes locales
/docker/data/
docker-compose.override.yml

# IDE y sistema operativo
/.idea/
/.vscode/
/.fleet/
/.nova/
/.zed/
/.cursor/
/.codex/
.DS_Store
Thumbs.db
*.log
