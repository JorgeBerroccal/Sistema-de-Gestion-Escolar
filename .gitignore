# Claude Code: configuración local y credenciales (las skills compartidas sí se versionan)
.claude/settings.local.json
.claude/.credentials.json
.claude/**/*credentials*
.claude/**/*.local.*

# Variables de entorno (se versiona solo la plantilla .env.example)
.env
.env.*
!.env.example

# Dependencias
/vendor/
/node_modules/

# Laravel: storage, caché y assets compilados
# Se versiona la estructura de storage/ (archivos .gitkeep) y se ignora su contenido.
/storage/**
!/storage/**/
!/storage/**/.gitkeep
/bootstrap/cache/*
!/bootstrap/cache/.gitignore
/public/build/
/public/hot
/public/storage

# Pruebas y herramientas
/.phpunit.cache/
.phpunit.result.cache
/coverage/
auth.json

# Docker: datos persistentes locales
/docker/data/
docker-compose.override.yml

# IDE y sistema operativo
/.idea/
/.vscode/
/.fleet/
.DS_Store
Thumbs.db
*.log
